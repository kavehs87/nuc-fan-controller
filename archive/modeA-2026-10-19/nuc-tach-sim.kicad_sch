	(text "J2: pin1 -> Arduino D9, pin2 -> 5V into the Pro Mini's RAW pin, pin3 -> GND. 3.3V / 8MHz board: its own regulator makes 3.3V, so 5V never goes to VCC. Header is rated 0.25A total."
		(exclude_from_sim no)
		(at 45 52 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "1a4f40ff-03d3-41a0-87da-a6f9f207e813")
	)
	(text "BIOS reads RPM = 30 x tach frequency. 50 Hz = 1500 RPM, 133 Hz = 4000 RPM."
		(exclude_from_sim no)
		(at 45 47 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "858076c7-6ff6-4df0-8bd8-088b83eb4e10")
	)
	(text "J1 pin numbers are this board's labels, not Intel's. Intel publishes no pinout for this header - identify the four wires with a meter first."
		(exclude_from_sim no)
		(at 45 56 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "8c609d0b-e8f0-4c62-81d8-68a78839b793")
	)
	(text "NUC tach simulator - Mode A (fixed RPM)"
		(exclude_from_sim no)
		(at 45 40 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "b0cc3d34-2801-4f82-968c-441e623dbb23")
	)
	(text "Q1 is open-collector: it only ever pulls NUC_TACH low. The pull-up lives in the NUC."
		(exclude_from_sim no)
		(at 45 60 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "cbbf040c-0049-4399-a031-90ab5098a5ab")
	)
