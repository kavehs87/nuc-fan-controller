	)
	(text "Measured from this schematic's own simulation (sim/out/): it turns on at Vgs = 2.01 V, the fan draws 147 mA, the drain\nsits at 6 mV when the switch is on, the turn-off spike is clamped to 12.76 V by D1, the Arduino pin peaks at 5 mA and the\ngate settles in about 10 us. Run ./sim/run.sh to regenerate the plots, or press the simulator button in KiCad.\nSee README.md for the full walkthrough."
		(exclude_from_sim no)
		(at 40 258 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "8a327a39-49cc-4023-a258-2eba208cff33")
	)
